<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app read the installed version of every app it
         manages, including future ones not known at build time.
         This is a personal, sideloaded tool and is not distributed
         through Play, so the broad visibility is deliberate. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Required alongside USER_ACTION_NOT_REQUIRED for unattended
         updates on Android 12+: with it declared, an update session
         needs no confirmation when this app is the installer of
         record for the target (or is updating itself) and the target
         meets the platform's targetSdk floor. Without the
         declaration the system always asks. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GitHub Releases source (v0.1.8 pilot, moka-vpn only): the
         on-device Drive provider served stale bytes for current
         releases, so this one project is fetched over plain HTTPS
         instead. No credentials: the repository is public. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Apps Updater"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- singleTop: an `am start` against the already-running
             instance is then guaranteed to arrive via onNewIntent
             (with the auto-download extras), instead of the intent
             being silently absorbed by the running top instance on
             some devices — observed on the ZTE Libero, where the
             delivered-to-top path never triggered the auto flow and
             duplicate instances stacked up. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller session results for in-app installs.
             Mirrors phone-node's UpdateReceiver: on
             STATUS_PENDING_USER_ACTION it posts a high-importance
             notification whose tap launches the confirmation, because
             a direct activity start from a background receiver is
             silently dropped on Android 10+. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.moriya.appsupdater.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
